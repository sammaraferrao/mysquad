{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--no-sandbox",
        "--headless",
        "--executable-path",
        "/opt/pw-browsers/chromium-1194/chrome-linux/chrome",
        "--user-data-dir",
        "/home/user/mysquad/_opensquad/_browser_profile"
      ],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "/opt/pw-browsers",
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1"
      }
    }
  }
}
